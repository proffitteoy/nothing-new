# Bangumi（仅服务端读取，请勿使用 NEXT_PUBLIC_ 前缀）
BANGUMI_ACCESS_TOKEN=
BANGUMI_USERNAME=

# Vercel Blob：承载番剧快照、BGM 封面和全站自有图片。新项目优先使用自动注入的 OIDC + BLOB_STORE_ID；旧 store 可继续使用读写 token。
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# 手动同步与 Vercel Cron 分离鉴权。
ANIME_SYNC_SECRET=
CRON_SECRET=

# 论文监控 Action 推送周报的共享密钥，仅服务端读取；与监控仓库 BLOG_SYNC_SECRET 一致。
PAPERS_SYNC_SECRET=
