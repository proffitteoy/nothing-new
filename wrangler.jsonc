{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "cloudflare-worker.mjs",
	"build": { "command": "npm run cf:build -- --skipNextBuild" },
	"name": "nothing-new",
	"workers_dev": true,
	"compatibility_date": "2026-11-26",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Node's virtual filesystem needs notes and About sources on cache misses.
	"find_additional_modules": true,
	"rules": [
		{ "type": "Text", "globs": [".quartz-cache/next/**/*.json", "app/about/*.md"], "fallthrough": false },
		{ "type": "Data", "globs": [], "fallthrough": false },
		{ "type": "CompiledWasm", "globs": [], "fallthrough": false }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		// OpenNext incremental cache; no R2 activation is required.
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "84f589d3b15b493eb48655b6cc55a022"
		},
		{
			"binding": "SITE_CONTENT",
			"id": "5a43f11ca93e4716b213676c090a68ca"
		}
	],
	"durable_objects": {
        "bindings": [
            { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
            { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" },
            { "name": "SITE_RUNTIME", "class_name": "SiteRuntime" }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] },
        { "tag": "v2", "new_sqlite_classes": ["SiteRuntime"] }
    ],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"triggers": { "crons": ["0 3 * * *"] },
	"previews": {
		"kv_namespaces": [
			{
				"binding": "NEXT_INC_CACHE_KV",
				"id": "0a0a19b39d1341d6bd73f67c8feb0b14"
			},
			{
				"binding": "SITE_CONTENT",
				"id": "aa87e880f7e3487197f9e74f2e316f18"
			}
		],
		"durable_objects": {
			"bindings": [
				{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
				{ "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" },
				{ "name": "SITE_RUNTIME", "class_name": "SiteRuntime" }
			]
		},
		"images": { "binding": "IMAGES" }
	}
}
